<%- include("partials/header") %>

<section class="page-intro">
    <p class="section-label">MANAGE CATEGORIES</p>

    <h1>Edit Category</h1>

    <p>
        Update the name of this service project category.
    </p>
</section>

<section class="form-section">
    <div class="form-card">

        <form action="/edit-category/<%= category.category_id %>" method="POST">

            <div class="form-group">
                <label for="name">Category Name</label>

                <input
                    type="text"
                    id="name"
                    name="name"
                    value="<%= category.name %>"
                    required
                    maxlength="100"
                >
            </div>

            <button type="submit" class="dark-button">
                Update Category
            </button>

        </form>

    </div>
</section>

<%- include("partials/footer") %>