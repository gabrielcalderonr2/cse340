
<%- include("partials/header") %>

<section class="page-intro">
    <p class="section-label">MANAGE ORGANIZATIONS</p>

    <h1>Edit Organization</h1>

    <p>
        Update the information for this partner organization.
    </p>
</section>

<section class="form-section">
    <div class="form-card">

        <form
            action="/edit-organization/<%= organization.organization_id %>"
            method="POST"
        >
            <div class="form-group">
                <label for="name">Organization Name</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    value="<%= organization.name %>"
                    maxlength="150"
                    required
                >
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea
                    id="description"
                    name="description"
                    rows="4"
                    required
                ><%= organization.description %></textarea>
            </div>

            <div class="form-group">
                <label for="contact_email">Contact Email</label>
                <input
                    type="email"
                    id="contact_email"
                    name="contact_email"
                    value="<%= organization.contact_email %>"
                    maxlength="255"
                    required
                >
            </div>

            <div class="form-group">
                <label for="logo_filename">Logo Filename</label>
                <input
                    type="text"
                    id="logo_filename"
                    name="logo_filename"
                    value="<%= organization.logo_filename %>"
                    maxlength="255"
                    required
                >
            </div>

            <button type="submit" class="dark-button">
                Update Organization
            </button>

            <a
                href="/organization/<%= organization.organization_id %>"
                class="category-link"
            >
                Cancel
            </a>
        </form>

    </div>
</section>

<%- include("partials/footer") %>
