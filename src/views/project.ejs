
<%- include("partials/header") %>

<section class="page-intro">
  <p class="section-label">SERVICE PROJECT</p>

  <h1><%= project.title %></h1>

  <p>
    Learn more about this service opportunity and how you can make an impact.
  </p>
</section>

<section class="project-details">
  <div class="project-card">
    <div class="project-content">

      <p><strong>Description:</strong></p>
      <p><%= project.description %></p>

      <p>
        <strong>Date:</strong>
        <%= new Date(project.date).toLocaleDateString("en-US", {
          timeZone: "UTC",
          year: "numeric",
          month: "long",
          day: "numeric"
        }) %>
      </p>

      <p>
        <strong>Location:</strong>
        <%= project.location %>
      </p>

      <p>
        <strong>Categories:</strong>

        <% if (categories && categories.length > 0) { %>
          <% categories.forEach(category => { %>
            <a href="/category/<%= category.category_id %>">
              <%= category.name %>
            </a>
          <% }) %>
        <% } else { %>
          No categories assigned.
        <% } %>
      </p>

      <p>
        <strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
          <%= project.organization_name %>
        </a>
      </p>

      <% if (user) { %>
        <section class="volunteer-section">
          <h2>Volunteer for this project</h2>

          <% if (volunteering) { %>
            <p>You are volunteering for this project.</p>

            <form
              action="/project/<%= project.project_id %>/remove-volunteer"
              method="POST"
            >
              <button type="submit" class="dark-button">
                Remove My Volunteer Signup
              </button>
            </form>
          <% } else { %>
            <p>
              Interested in helping? Sign up to volunteer for this project.
            </p>

            <form
              action="/project/<%= project.project_id %>/volunteer"
              method="POST"
            >
              <button type="submit" class="primary-button">
                Volunteer for This Project
              </button>
            </form>
          <% } %>
        </section>
      <% } %>

      <% if (user && user.role_name === "admin") { %>
        <div class="category-actions">
          <a
            href="/edit-project/<%= project.project_id %>"
            class="dark-button"
          >
            Edit Project
          </a>

          <a
            href="/project/<%= project.project_id %>/assign-categories"
            class="dark-button"
          >
            Assign Categories
          </a>
        </div>
      <% } %>

    </div>
  </div>
</section>

<%- include("partials/footer") %>
