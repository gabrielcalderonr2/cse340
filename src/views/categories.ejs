<%- include("partials/header") %>

<section class="page-intro">
    <p class="section-label">FIND YOUR CAUSE</p>

    <h1>Service Project Categories</h1>

    <p>
        Explore service opportunities by choosing an area that matters to you.
    </p>
</section>

<section class="category-grid">

    <% categories.forEach(category => { %>
        <article class="category-card">

            <div class="category-icon" aria-hidden="true">
                <% if (category.name === 'Environment') { %>
                    🌱
                <% } else if (category.name === 'Education') { %>
                    📚
                <% } else { %>
                    🤝
                <% } %>
            </div>

            <h2><%= category.name %></h2>

            <p>
                Explore service opportunities and make a difference
                in your community through <%= category.name.toLowerCase() %>.
            </p>

            <a href="/projects" class="category-link">
                Explore projects →
            </a>

        </article>
    <% }) %>

</section>

<section class="impact-callout">
    <h2>Find something that inspires you.</h2>

    <p>
        Your time and talents can help create meaningful change.
    </p>

    <a href="/projects" class="dark-button">
        Explore Projects →
    </a>
</section>

<%- include("partials/footer") %>