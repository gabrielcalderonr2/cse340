<%- include("partials/header") %>

<section class="page-intro">

  <p class="section-label">OUR PARTNERS</p>

  <h1>Partner Organizations</h1>

  <p>
    These organizations work tirelessly to create positive change in our
    communities through service, education, and support.
  </p>

</section>

<section class="organization-grid">

  <% organizations.forEach(organization => { %>

    <article class="organization-card">

      <% if (organization.name === "BrightFuture Builders") { %>

        <img
          src="/images/food-bank.jpg"
          alt="Volunteers organizing food donations at a community food bank"
        >

      <% } else if (organization.name === "GreenHarvest Growers") { %>

        <img
          src="/images/green-earth.jpg"
          alt="Volunteers planting trees in a community park"
        >

      <% } else if (organization.name === "UnityServe Volunteers") { %>

        <img
          src="/images/youth-education.jpg"
          alt="Volunteer helping a student with school work"
        >

      <% } %>

      <div class="organization-content">

        <h2>
          <%= organization.name %>
        </h2>

        <p>
          <%= organization.description %>
        </p>

        
<div class="category-actions">
  <a
    href="/organization/<%= organization.organization_id %>"
    class="card-button"
  >
    Learn More →
  </a>

  <a
    href="/edit-organization/<%= organization.organization_id %>"
    class="dark-button"
  >
    Edit Organization
  </a>
</div>


      </div>

    </article>

  <% }) %>

</section>

<div class="category-actions">
    <a href="/new-organization" class="dark-button">
        Create New Organization
    </a>
</div>

<section class="partner-callout">

  <div>

    <h2>Interested in becoming a partner?</h2>

    <p>
      We are always looking to collaborate with organizations that share our
      vision for stronger communities.
    </p>

  </div>

  <a href="/projects" class="dark-button">
    Get Involved →
  </a>

</section>

<%- include("partials/footer") %>