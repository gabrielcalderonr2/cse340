
<%- include("partials/header") %>

<section class="page-intro">
    <p class="section-label">MANAGE ORGANIZATIONS</p>

    <h1>Create New Organization</h1>

    <p>
        Add a partner organization to the Service Connect community.
    </p>
</section>

<section class="form-section">
    <div class="form-card">

        <form action="/new-organization" method="POST">

            <div class="form-group">
                <label for="name">Organization Name</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    maxlength="150"
                    required
                >
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea
                    id="description"
                    name="description"
                    rows="4"
                    required
                ></textarea>
            </div>

            <div class="form-group">
                <label for="contact_email">Contact Email</label>
                <input
                    type="email"
                    id="contact_email"
                    name="contact_email"
                    maxlength="255"
                    required
                >
            </div>

            <div class="form-group">
                <label for="logo_filename">Logo Filename</label>
                <input
                    type="text"
                    id="logo_filename"
                    name="logo_filename"
                    maxlength="255"
                    placeholder="example-logo.png"
                    required
                >
                <small>
                    Enter the filename of an image in the public/images folder.
                </small>
            </div>

            <button type="submit" class="dark-button">
                Create Organization
            </button>

            <a href="/organizations" class="category-link">
                Cancel
            </a>

        </form>

    </div>
</section>

<%- include("partials/footer") %>
