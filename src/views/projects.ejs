<%- include("partials/header") %>

<section class="page-intro">

  <p class="section-label">MAKE AN IMPACT</p>

  <h1>Upcoming Service Projects</h1>

  <p>
    Discover meaningful opportunities to serve, connect with others,
    and create positive change in your community.
  </p>

</section>

<div class="category-actions">
    <a href="/new-project" class="dark-button">
        Create New Service Project
    </a>
</div>

<section class="project-grid">

  <% if (projects && projects.length > 0) { %>

    <% projects.forEach(project => { %>

      <article class="project-card">

        <div class="project-icon" aria-hidden="true">🌱</div>

        <div class="project-content">

          <span class="project-category">
            <%= project.location %>
          </span>

          <h2>
            <a href="/project/<%= project.project_id %>">
              <%= project.title %>
            </a>
          </h2>

          <p>
            <%= project.description %>
          </p>

          <p>
            <strong>Date:</strong>
            <%= new Date(project.date).toLocaleDateString("en-US", {
              timeZone: "UTC",
              year: "numeric",
              month: "long",
              day: "numeric"
            }) %>
          </p>

          <p>
            Organization:
            <a href="/organization/<%= project.organization_id %>">
              <%= project.organization_name %>
            </a>
          </p>

        </div>

      </article>

    <% }); %>

  <% } else { %>

    <p>No service projects are currently available.</p>

  <% } %>

</section>

<section class="impact-callout">

  <h2>Every action makes a difference.</h2>

  <p>
    Find an opportunity, give your time, and help strengthen your community.
  </p>

  <a href="/organizations" class="dark-button">
    Find an Organization →
  </a>

</section>

<%- include("partials/footer") %>