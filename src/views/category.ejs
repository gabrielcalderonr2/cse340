<%- include("partials/header") %>

<section class="page-intro">

  <p class="section-label">SERVICE CATEGORY</p>

  <h1><%= category.name %></h1>

  <p>
    Explore service projects that belong to this category.
  </p>

</section>

<section class="project-grid">

  <% if (projects && projects.length > 0) { %>

    <% projects.forEach(project => { %>

      <article class="project-card">

        <div class="project-icon" aria-hidden="true">🌱</div>

        <div class="project-content">

          <span class="project-category">
            <%= project.location %>
          </span>

          <h2>
            <a href="/project/<%= project.project_id %>">
              <%= project.title %>
            </a>
          </h2>

          <p>
            <%= project.description %>
          </p>

          <p>
            <strong>Date:</strong>
            <%= new Date(project.date).toLocaleDateString("en-US", {
              timeZone: "UTC",
              year: "numeric",
              month: "long",
              day: "numeric"
            }) %>
          </p>

          <p>
            <strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
              <%= project.organization_name %>
            </a>
          </p>

        </div>

      </article>

    <% }); %>

  <% } else { %>

    <p>No service projects are currently available for this category.</p>

  <% } %>

</section>

<%- include("partials/footer") %>